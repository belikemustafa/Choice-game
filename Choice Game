    function renderArena(animateTop = false, animateBottom = false) {
      const totalDuels = Math.max(1, state.roundChoices.length - 1);
      const isFinal = state.duelNumber === totalDuels;

      const roundLabelEl = document.getElementById('arena-round-label');
      roundLabelEl.textContent = isFinal ? 'FINAL DUEL · DECIDE YOUR CHAMPION' : `DUEL ${state.duelNumber} OF ${totalDuels}`;
