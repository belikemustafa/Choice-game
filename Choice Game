    function applyCreatorTemplate(tplKey) {
      const tpl = CREATOR_TEMPLATES[tplKey];
      if (!tpl) return;
      document.getElementById('creator-title').value = tpl.title;
      document.getElementById('creator-category').value = tpl.category;
      document.getElementById('creator-subtitle').value = tpl.subtitle;
