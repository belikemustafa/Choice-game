        subBar.classList.remove('hidden');
        subBar.innerHTML = deck.subFilters.map((sf) => {
          const isSubActive = state.activeSubFilter === sf.id;
          return `
            <button
              type="button"
              data-sub-pill="${escapeHtml(sf.id)}"
              class="sub-pill shrink-0 px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-all border ${
