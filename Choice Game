    /**
     * Renders the horizontal scrollable 9-category pill bar + sub-filter pills
     * for Movies (All / Global / Indian) and TV Serials (All / Global Series / Indian Serials & Shows).
     */
    function renderCategoryBar() {
      const bar = document.getElementById('category-pill-bar');
      const activeId = state.activeDeck?.isCustom ? null : state.activeDeck?.id;

      bar.innerHTML = BUILTIN_CATEGORIES.map((cat) => {
