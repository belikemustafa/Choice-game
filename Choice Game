      const rect = anchorEl.getBoundingClientRect();
      pop.style.top = `${Math.min(window.innerHeight - 240, Math.max(12, rect.bottom + 8))}px`;
      pop.style.left = `${Math.min(window.innerWidth - 276, Math.max(12, rect.left))}px`;
      pop.classList.remove('hidden');
    }

    function closeEmojiPopover() {
      document.getElementById('emoji-popover').classList.add('hidden');
      state.activeEmojiSlotIdx = null;
    }

    async function handleSaveCustomDeck() {
      const title = document.getElementById('creator-title').value.trim();
      const categoryLabel = document.getElementById('creator-category').value || 'Custom';
      const subtitle = document.getElementById('creator-subtitle').value.trim();

      if (!title) {
        showToast('Please enter a Deck Title first.', 'warn');
        document.getElementById('creator-title').focus();
        return;
      }

      const emptyIndex = state.creatorSlots.findIndex((s) => !s.name.trim());
      if (emptyIndex !== -1) {
        showToast(`Please fill in Choice #${emptyIndex + 1} (all 10 required).`, 'warn');
        document.querySelector(`[data-name-slot="${emptyIndex}"]`)?.focus();
        return;
      }

      const deckId = `d_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 6)}`;
      const newDeck = {
        id: deckId,
        title,
        categoryLabel,
        subtitle,
        isCustom: true,
        createdAt: Date.now(),
        totalPlays: 0,
        champions: {},
        duelWins: {},
        appearances: {},
        choices: state.creatorSlots.map((s, idx) => ({
          id: `c${idx + 1}`,
          name: s.name.trim(),
          tag: (s.tag || '').trim(),
          emoji: s.emoji || '✨',
          paletteIdx: s.paletteIdx % PALETTES.length,
          gradient: PALETTES[s.paletteIdx % PALETTES.length],
          img: s.img ? s.img.trim() : null,
          wikiSlug: '',
          seedVotes: 0,
        }))
      };

      const btn = document.getElementById('btn-save-deck');
      btn.disabled = true;
      btn.textContent = 'Saving...';

      await saveCustomDeckToStore(newDeck);

      btn.disabled = false;
      btn.innerHTML = `<span>Save &amp; Get Share Link</span><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>`;

      state.lastCreatedDeck = newDeck;
      document.getElementById('creator-share-url').value = buildShareUrl(newDeck);
      document.getElementById('creator-form-wrap').classList.add('hidden');
      document.getElementById('creator-share-ready').classList.remove('hidden');
      showToast('Deck saved! Share the link with friends.', 'success');
    }

    // =========================================================================
    // 11. IFRAME-SAFE CLIPBOARD & TOAST HELPERS
    // =========================================================================
    function copyTextToClipboard(text, successMsg = 'Share link copied!') {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, text.length);
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        if (ok) {
          showToast(successMsg, 'success');
          return;
        }
      } catch (_) {}
      showToast('Select and copy the share link manually.', 'warn');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const accent =
        type === 'success' ? 'border-emerald-400/40 text-emerald-200' :
        type === 'warn' ? 'border-[#e0b34c]/50 text-[#f3cf78]' :
        'border-[#2b3040] text-zinc-100';

      toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl bg-[#161922]/95 backdrop-blur-md border ${accent} text-xs font-semibold shadow-2xl animate-in text-center`;
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(6px)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 260);
      }, 2600);
    }

    // =========================================================================
    // 12. EVENT LISTENERS & INITIALIZATION
    // =========================================================================
    function setupEventListeners() {
      // Top Navigation
      document.getElementById('btn-create-own').addEventListener('click', openCreator);
      document.getElementById('btn-open-shared').addEventListener('click', openSharedModal);
      document.getElementById('btn-toggle-sound').addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        document.getElementById('icon-sound-on').classList.toggle('hidden', !soundEnabled);
        document.getElementById('icon-sound-off').classList.toggle('hidden', soundEnabled);
        if (soundEnabled) playClickTone(520);
      });

      // Arena controls
      document.getElementById('card-top').addEventListener('click', () => handlePick('top'));
      document.getElementById('card-bottom').addEventListener('click', () => handlePick('bottom'));

      document.getElementById('btn-toggle-names').addEventListener('click', () => {
        state.hideNames = !state.hideNames;
        renderArena(false, false);
      });

      document.getElementById('btn-arena-reshuffle').addEventListener('click', () => {
        playClickTone(500);
        startRound(state.activeDeck, { subFilter: state.activeSubFilter });
        showToast('Dealt 10 fresh choices!', 'info');
      });

      // Keyboard controls (1 / 2 or ArrowUp / ArrowDown)
      window.addEventListener('keydown', (e) => {
        if (state.view !== 'arena') return;
        if (!document.getElementById('modal-shared').classList.contains('hidden')) return;
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

        if (e.key === '1' || e.key === 'ArrowUp') {
          e.preventDefault();
          handlePick('top');
        } else if (e.key === '2' || e.key === 'ArrowDown') {
          e.preventDefault();
          handlePick('bottom');
        }
      });

      // Results & Taste Rating controls
      document.getElementById('btn-toggle-taste').addEventListener('click', () => {
        state.tasteExpanded = !state.tasteExpanded;
        playClickTone(state.tasteExpanded ? 480 : 380);
        updateTasteAccordionUI();
      });

      document.getElementById('tab-this-post').addEventListener('click', () => {
        state.tasteTab = 'post';
        updateTasteAccordionUI();
      });

      document.getElementById('tab-your-persona').addEventListener('click', () => {
        state.tasteTab = 'persona';
        renderPersonaTab();
        updateTasteAccordionUI();
      });

      document.getElementById('btn-lb-round').addEventListener('click', () => {
        state.lbMode = 'round';
        renderLeaderboardRows();
      });

      document.getElementById('btn-lb-all').addEventListener('click', () => {
        state.lbMode = 'all';
        renderLeaderboardRows();
      });

      document.getElementById('btn-play-next').addEventListener('click', () => {
        playClickTone(520);
        startRound(state.activeDeck, { subFilter: state.activeSubFilter });
      });

      document.getElementById('btn-rematch-same').addEventListener('click', () => {
        playClickTone(440);
        startRound(state.activeDeck, {
          subFilter: state.activeSubFilter,
          rematchSameChoices: state.roundChoices
        });
        showToast('Rematch! Same 10 shuffled fresh.', 'info');
      });

      document.getElementById('btn-share-current').addEventListener('click', () => {
        copyTextToClipboard(buildShareUrl(state.activeDeck), 'Deck link copied! Challenge your friends.');
      });

      // Creator controls
      document.getElementById('btn-creator-back').addEventListener('click', () => {
        showView(state.champion ? 'results' : 'arena');
      });

      document.getElementById('btn-tpl-scifi').addEventListener('click', () => applyCreatorTemplate('scifi'));
      document.getElementById('btn-tpl-tv').addEventListener('click', () => applyCreatorTemplate('tv'));
      document.getElementById('btn-tpl-careers').addEventListener('click', () => applyCreatorTemplate('careers'));

      document.getElementById('btn-toggle-paste').addEventListener('click', () => {
        document.getElementById('quick-paste-box').classList.toggle('hidden');
      });

      document.getElementById('btn-apply-paste').addEventListener('click', () => {
        const raw = document.getElementById('quick-paste-input').value;
        const lines = raw.split(/\r?\n/).map((l) => l.trim()).filter(Boolean).slice(0, 10);
        if (lines.length === 0) {
          showToast('Paste at least one line first.', 'warn');
          return;
        }
        lines.forEach((line, idx) => {
          const [namePart, tagPart] = line.split('|').map((s) => s.trim());
          state.creatorSlots[idx].name = (namePart || '').slice(0, 52);
          if (tagPart) state.creatorSlots[idx].tag = tagPart.slice(0, 32);
        });
        document.getElementById('quick-paste-box').classList.add('hidden');
        renderCreatorSlots();
        showToast(`Populated ${lines.length} choices!`, 'success');
      });

      document.getElementById('btn-clear-form').addEventListener('click', () => {
        document.getElementById('creator-title').value = '';
        document.getElementById('creator-subtitle').value = '';
        document.getElementById('creator-category').value = 'Custom';
        initCreatorSlots();
        renderCreatorSlots();
      });

      document.getElementById('btn-save-deck').addEventListener('click', handleSaveCustomDeck);

      document.getElementById('btn-creator-copy').addEventListener('click', () => {
        copyTextToClipboard(document.getElementById('creator-share-url').value, 'Share link copied! Send it to friends.');
      });

      document.getElementById('btn-creator-play-now').addEventListener('click', () => {
        if (state.lastCreatedDeck) startRound(state.lastCreatedDeck);
      });

      document.getElementById('btn-creator-make-another').addEventListener('click', () => {
        document.getElementById('creator-title').value = '';
        document.getElementById('creator-subtitle').value = '';
        initCreatorSlots();
        openCreator();
      });

      // Shared Decks Modal
      document.getElementById('btn-close-shared').addEventListener('click', closeSharedModal);
      document.getElementById('modal-shared').addEventListener('click', (e) => {
        if (e.target.id === 'modal-shared') closeSharedModal();
      });
      document.getElementById('btn-modal-create').addEventListener('click', () => {
        closeSharedModal();
        openCreator();
      });

      document.getElementById('btn-load-share').addEventListener('click', async () => {
        const val = document.getElementById('input-load-share').value;
        if (!val.trim()) return;
        const parsed = parseDeckFromShareString(val);
        if (!parsed) {
          showToast('Invalid share link or deck ID.', 'warn');
          return;
        }
        if (parsed.catIdOnly) {
          const cat = BUILTIN_CATEGORIES.find((c) => c.id === parsed.catIdOnly);
          if (cat) {
            closeSharedModal();
            startRound(cat, { subFilter: parsed.subFilter || 'all' });
            return;
          }
        }
        if (parsed.deckIdOnly) {
          const fetched = await fetchCustomDeckById(parsed.deckIdOnly);
          if (fetched) {
            closeSharedModal();
            startRound({ ...fetched, isCustom: true });
            return;
          }
          showToast('Deck not found — paste the full share URL.', 'warn');
          return;
        }
        const existing = await fetchCustomDeckById(parsed.id);
        const deckToPlay = existing ? { ...existing, isCustom: true } : parsed;
        if (!existing) customDecksCache[parsed.id] = parsed;
        closeSharedModal();
        startRound(deckToPlay);
        showToast(`Loaded "${deckToPlay.title}"!`, 'success');
      });

      // Emoji picker popover
      const emojiGrid = document.getElementById('emoji-grid');
      emojiGrid.innerHTML = CREATOR_EMOJIS.map((em) => `
        <button type="button" class="emoji-pick-btn w-7 h-7 rounded-lg hover:bg-white/10 flex items-center justify-center text-base transition-colors">${em}</button>
      `).join('');

      emojiGrid.querySelectorAll('.emoji-pick-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (state.activeEmojiSlotIdx !== null) {
            state.creatorSlots[state.activeEmojiSlotIdx].emoji = btn.textContent;
            renderCreatorSlots();
          }
          closeEmojiPopover();
        });
      });

      document.getElementById('btn-close-emoji').addEventListener('click', closeEmojiPopover);
      document.addEventListener('click', (e) => {
        const pop = document.getElementById('emoji-popover');
        if (!pop.classList.contains('hidden') && !pop.contains(e.target) && !e.target.closest('.btn-slot-emoji')) {
          closeEmojiPopover();
        }
      });
    }

    async function boot() {
      setupEventListeners();
      initCreatorSlots();

      await initFirebase();

      // Check URL for shared deck (?deck=...#custom=...) or category (?cat=...&sub=...)
      const parsedFromUrl = parseDeckFromShareString(window.location.href);
      if (parsedFromUrl) {
        if (parsedFromUrl.catIdOnly) {
          const cat = BUILTIN_CATEGORIES.find((c) => c.id === parsedFromUrl.catIdOnly);
          if (cat) {
            startRound(cat, { subFilter: parsedFromUrl.subFilter || 'all' });
            return;
          }
        } else if (parsedFromUrl.deckIdOnly) {
          const fetched = await fetchCustomDeckById(parsedFromUrl.deckIdOnly);
          if (fetched) {
            startRound({ ...fetched, isCustom: true });
            return;
          }
        } else if (parsedFromUrl.isCustom) {
          const existing = await fetchCustomDeckById(parsedFromUrl.id);
          const deckToPlay = existing ? { ...existing, isCustom: true } : parsedFromUrl;
          if (!existing) customDecksCache[parsedFromUrl.id] = parsedFromUrl;
          startRound(deckToPlay);
          return;
        }
      }

      // Default launch: Movies flagship category
      startRound(BUILTIN_CATEGORIES[0], { subFilter: 'all' });
    }

    window.addEventListener('DOMContentLoaded', boot);
  </script>
