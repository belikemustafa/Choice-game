    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function showView(viewName) {
      state.view = viewName;
      document.getElementById('view-arena').classList.toggle('hidden', viewName !== 'arena');
      document.getElementById('view-results').classList.toggle('hidden', viewName !== 'results');
      document.getElementById('view-creator').classList.toggle('hidden', viewName !== 'creator');
      document.getElementById('category-nav-wrap').classList.toggle('hidden', viewName === 'creator');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateHeader() {
      const deck = state.activeDeck;
      if (!deck) return;
      document.getElementById('header-vote-count').textContent = formatVoteCount(getDeckTotalVotes(deck));
