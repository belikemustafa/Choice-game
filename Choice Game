<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>PickOff — 10-Choice Knockout &amp; Taste Rating</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
          colors: {
            obsidian: '#0d0e12',
            surface: '#14161c',
            surfaceHover: '#1b1e26',
            borderSubtle: '#1d2028',
            goldAccent: '#e0b34c',
            champBorder: '#7c3526',
            champTint: '#251514',
          }
        }
      }
    };
  </script>
  <style>
    :root {
      color-scheme: dark;
    }

    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      background-color: #0d0e12;
      color: #f4f4f5;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overflow-x: hidden;
      min-height: 100dvh;
    }

    /* Ambient obsidian depth glow */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(640px circle at 50% -10%, rgba(224, 179, 76, 0.055), transparent 65%),
        radial-gradient(500px circle at 90% 95%, rgba(56, 189, 248, 0.035), transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    /* Hide scrollbars cleanly for horizontal pill rails */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Arena card sizing: comfortably fits two vertical cards + VS badge in viewport */
    .arena-card {
      width: min(100%, 312px);
      height: clamp(182px, 32.5dvh, 286px);
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      cursor: pointer;
      user-select: none;
      border: 1px solid #232733;
      background-color: #14161c;
      transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.22s ease,
                  box-shadow 0.22s ease,
                  opacity 0.2s ease;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.52);
    }

    .arena-card:hover {
      transform: translateY(-2px) scale(1.012);
      border-color: rgba(255, 255, 255, 0.24);
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.68);
    }

    .arena-card:active {
      transform: scale(0.982);
    }

    .arena-card.picked-win {
      border-color: rgba(224, 179, 76, 0.8);
      box-shadow: 0 0 0 2px rgba(224, 179, 76, 0.28), 0 18px 44px rgba(0, 0, 0, 0.7);
      transform: scale(1.022);
    }

    .arena-card.picked-lose {
      opacity: 0.14;
      transform: scale(0.93);
    }

    .arena-card.challenger-enter {
      animation: challengerEnter 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes challengerEnter {
      0% {
        opacity: 0;
        transform: translateY(14px) scale(0.96);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Cinematic dark poster vignette matching reference screenshots */
    .card-vignette {
      background: linear-gradient(
        180deg,
        rgba(9, 10, 14, 0.18) 0%,
        rgba(9, 10, 14, 0.05) 38%,
        rgba(9, 10, 14, 0.68) 72%,
        rgba(7, 8, 11, 0.96) 100%
      );
    }

    /* Subtle dotted film-grain/mesh pattern for bespoke poster cards */
    .art-mesh {
      background-image: radial-gradient(rgba(255, 255, 255, 0.075) 1px, transparent 1px);
      background-size: 16px 16px;
    }

    /* Metric cards with crisp colored left borders (cyan, orange, gold, green) */
    .metric-card {
      position: relative;
      background: #14161c;
      border: 1px solid #1f232d;
      border-radius: 12px;
      padding: 13px 13px 13px 16px;
      overflow: hidden;
    }

    .metric-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      border-radius: 3px 0 0 3px;
    }

    .metric-cyan::before { background: #4ea8de; }
    .metric-orange::before { background: #d97742; }
    .metric-gold::before { background: #e0b34c; }
    .metric-green::before { background: #52a47a; }

    /* Smooth accordion for YOUR TASTE RATING */
    .accordion-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .accordion-body.open {
      grid-template-rows: 1fr;
    }

    .accordion-inner {
      overflow: hidden;
    }

    /* Leaderboard bar fill animation */
    .lb-fill {
      transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
      animation: fadeSlideUp 0.26s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Custom subtle vertical scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 999px;
    }
  </style>
</head>
<body class="bg-obsidian text-zinc-100 antialiased selection:bg-amber-500/30 selection:text-amber-100">

  <!-- Main App Shell -->
  <div id="app" class="relative z-10 min-h-[100dvh] flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="w-full max-w-[560px] mx-auto px-4 pt-3.5 pb-1.5 flex items-center justify-between gap-2">
      <div class="flex items-center gap-3 min-w-0">
        <button
          id="btn-create-own"
          type="button"
          class="text-[13px] font-semibold text-[#e0b34c] hover:text-[#f2cc72] transition-colors whitespace-nowrap shrink-0 py-1 flex items-center gap-1"
          title="Create your own 10-choice deck"
        >
          <span>Create your own</span>
        </button>
        <span class="text-zinc-700 text-xs select-none">·</span>
        <button
          id="btn-open-shared"
          type="button"
          class="text-[12px] font-medium text-zinc-400 hover:text-zinc-100 transition-colors whitespace-nowrap shrink-0 py-1 flex items-center gap-1"
          title="Browse custom & shared decks"
        >
          <span>Shared Decks</span>
        </button>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <button
          id="btn-toggle-sound"
          type="button"
          class="p-1.5 rounded-lg text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.05] transition-colors"
          title="Toggle sound effects"
          aria-label="Toggle sound effects"
        >
          <svg id="icon-sound-on" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
          </svg>
          <svg id="icon-sound-off" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.531V19.94a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.506-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.395C2.806 8.757 3.63 8.25 4.51 8.25H6.75z" />
          </svg>
        </button>
        <div class="text-right text-[13px] whitespace-nowrap leading-none">
          <span id="header-vote-count" class="font-semibold text-zinc-100 tabular-nums">34.2k</span>
          <span class="text-zinc-500 ml-0.5">voted</span>
        </div>
      </div>
    </header>

    <!-- Horizontal Scrollable Category Pill Bar (9 Built-In Categories) -->
    <nav id="category-nav-wrap" class="w-full max-w-[560px] mx-auto px-4 pt-1 pb-1.5">
      <div id="category-pill-bar" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1">
        <!-- Populated dynamically -->
      </div>

      <!-- Optional Sub-Filter Pill Bar (Shown for Movies & TV Serials) -->
      <div id="subfilter-bar" class="hidden flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-1.5 pb-0.5">
        <!-- Populated dynamically -->
      </div>
    </nav>

    <!-- Main Dynamic Views Container -->
    <main class="flex-1 w-full max-w-[560px] mx-auto px-4 pb-8 flex flex-col">

      <!-- ============================================================
           VIEW 1: 1v1 KNOCKOUT ARENA (10 Choices = 9 Duels)
           ============================================================ -->
      <section id="view-arena" class="flex-1 flex flex-col items-center justify-center py-1">

        <!-- Custom Deck Banner (shown when playing a custom/shared deck) -->
        <div id="arena-custom-banner" class="hidden w-full max-w-[312px] mb-2 text-center">
          <div class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-wider font-bold text-[#e0b34c] bg-[#e0b34c]/10 border border-[#e0b34c]/25 px-2.5 py-0.5 rounded-full">
            <span>✦</span>
            <span id="arena-custom-cat-label">CUSTOM 10-CHOICE DECK</span>
          </div>
          <p id="arena-custom-title" class="text-sm font-bold text-white mt-1 truncate"></p>
          <p id="arena-custom-subtitle" class="text-[11px] text-zinc-400 truncate"></p>
        </div>

        <!-- Compact Round Progress Bar + Fresh 10 Control -->
        <div class="w-full max-w-[312px] mb-2.5">
          <div class="flex items-center justify-between text-[11px] font-semibold tracking-[0.11em] uppercase mb-1.5">
            <span id="arena-round-label" class="text-zinc-400">DUEL 1 OF 9</span>
            <button
              id="btn-arena-reshuffle"
              type="button"
              class="text-zinc-400 hover:text-[#e0b34c] transition-colors flex items-center gap-1 py-0.5"
              title="Deal 10 fresh unseen choices"
            >
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              <span>Fresh 10</span>
            </button>
          </div>
          <div class="w-full h-1 bg-white/[0.06] rounded-full overflow-hidden">
            <div id="arena-progress-bar" class="h-full bg-gradient-to-r from-[#d49c35] to-[#f0cc70] rounded-full transition-all duration-300" style="width: 11%;"></div>
          </div>
        </div>

        <!-- Top Contender Card -->
        <button id="card-top" type="button" class="arena-card group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#e0b34c]" aria-label="Choose top option">
          <!-- Populated dynamically -->
        </button>

        <!-- Centered Circular VS Divider -->
        <div class="w-full max-w-[312px] relative flex items-center justify-center my-2.5">
          <div class="w-full border-t border-dashed border-white/[0.08]"></div>
          <div class="absolute flex items-center justify-center w-10 h-10 rounded-full bg-[#151820] border border-[#262a36] shadow-lg text-[11px] font-bold tracking-widest text-zinc-400 select-none">
            VS
          </div>
        </div>

        <!-- Bottom Contender Card -->
        <button id="card-bottom" type="button" class="arena-card group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#e0b34c]" aria-label="Choose bottom option">
          <!-- Populated dynamically -->
        </button>

        <!-- Bottom Footer: TAP YOUR PICK · HIDE NAMES -->
        <div class="mt-3 flex items-center justify-center gap-2 text-[11px] font-semibold tracking-[0.14em] uppercase text-zinc-500 select-none">
          <span>TAP YOUR PICK</span>
          <span class="text-zinc-700">·</span>
          <button id="btn-toggle-names" type="button" class="hover:text-zinc-200 transition-colors py-1 px-1 rounded">
            HIDE NAMES
          </button>
        </div>
      </section>

      <!-- ============================================================
           VIEW 2: RESULTS, TASTE RATING & LIVE LEADERBOARD
           ============================================================ -->
      <section id="view-results" class="hidden animate-in space-y-3 pt-1">

        <!-- COLLAPSIBLE YOUR TASTE RATING CARD (Screenshots 2 & 3) -->
        <div id="taste-card" class="bg-[#12141a] border border-[#1d2028] rounded-2xl overflow-hidden shadow-xl">
          <button
            id="btn-toggle-taste"
            type="button"
            class="w-full px-4 py-3.5 flex items-center justify-between gap-3 hover:bg-white/[0.02] transition-colors text-left"
            aria-expanded="false"
          >
            <div class="flex items-stretch gap-3 min-w-0">
              <div class="w-1 rounded-full bg-[#e0b34c] shrink-0"></div>
              <div class="min-w-0">
                <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-zinc-400">
                  <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                  </svg>
                  <span>YOUR TASTE RATING</span>
                </div>
                <div id="taste-header-archetype" class="text-[17px] font-bold text-white leading-snug mt-0.5 truncate">
                  Balanced Critic
                </div>
              </div>
            </div>
            <svg id="taste-chevron" class="w-5 h-5 text-zinc-400 transition-transform duration-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <!-- Expanded Taste Analytics Panel -->
          <div id="taste-accordion" class="accordion-body">
            <div class="accordion-inner">
              <div class="px-4 pb-4 pt-3 border-t border-[#1d2028] space-y-4">
                <!-- Segmented Tab Switcher: THIS POST | YOUR PERSONA -->
                <div class="bg-[#0b0c10] border border-[#1d2028] rounded-xl p-1 grid grid-cols-2 gap-1">
                  <button
                    id="tab-this-post"
                    type="button"
                    class="py-2 rounded-lg text-[11px] font-bold uppercase tracking-[0.12em] bg-[#1a1d26] text-white transition-all"
                  >
                    THIS POST
                  </button>
                  <button
                    id="tab-your-persona"
                    type="button"
                    class="py-2 rounded-lg text-[11px] font-bold uppercase tracking-[0.12em] text-zinc-400 hover:text-zinc-200 transition-all"
                  >
                    YOUR PERSONA
                  </button>
                </div>

                <!-- Tab 1: THIS POST -->
                <div id="panel-this-post" class="space-y-3.5">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="w-1 h-4 rounded-full bg-[#e0b34c]"></span>
                      <h3 id="post-archetype-title" class="text-[17px] font-bold text-white">Balanced Critic</h3>
                    </div>
                    <p id="post-archetype-desc" class="text-[13px] text-zinc-400 mt-1 leading-relaxed">
                      Some with the room, some against. You pick your spots.
                    </p>
                  </div>

                  <!-- 2x2 Stat Card Grid -->
                  <div class="grid grid-cols-2 gap-2.5">
                    <div class="metric-card metric-cyan">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">CROWD SYNC</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="metric-crowd-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">50</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="metric-crowd-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Half with the crowd.</div>
                    </div>

                    <div class="metric-card metric-orange">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">RARE TASTE</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="metric-rare-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">55</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="metric-rare-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Off-radar a bit.</div>
                    </div>

                    <div class="metric-card metric-gold">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">HOT TAKES</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="metric-hot-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">72</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="metric-hot-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Spicy upsets.</div>
                    </div>

                    <div class="metric-card metric-green">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">SIGNATURE</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="metric-sig-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">53</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="metric-sig-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Loose pattern.</div>
                    </div>
                  </div>
                </div>

                <!-- Tab 2: YOUR PERSONA (Lifetime Aggregated Across Categories & Custom Decks) -->
                <div id="panel-your-persona" class="hidden space-y-3.5">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="w-1 h-4 rounded-full bg-[#e0b34c]"></span>
                        <h3 id="persona-archetype-title" class="text-[17px] font-bold text-white truncate">Balanced Critic</h3>
                      </div>
                      <p id="persona-archetype-desc" class="text-[13px] text-zinc-400 mt-1 leading-relaxed">
                        Your lifetime taste profile across every round played.
                      </p>
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                      <span id="persona-rounds-badge" class="text-[11px] font-semibold bg-white/[0.06] border border-[#262a36] text-zinc-200 px-2.5 py-0.5 rounded-full">
                        1 round
                      </span>
                      <span id="persona-top-cat" class="text-[10px] font-semibold text-[#e0b34c] bg-[#e0b34c]/10 border border-[#e0b34c]/20 px-2 py-0.5 rounded-full truncate max-w-[130px]">
                        Top: Movies
                      </span>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 gap-2.5">
                    <div class="metric-card metric-cyan">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">AVG CROWD SYNC</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="persona-crowd-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">50</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="persona-crowd-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Across all rounds.</div>
                    </div>

                    <div class="metric-card metric-orange">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">AVG RARE TASTE</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="persona-rare-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">55</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="persona-rare-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Across all rounds.</div>
                    </div>

                    <div class="metric-card metric-gold">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">AVG HOT TAKES</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="persona-hot-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">72</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="persona-hot-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Across all rounds.</div>
                    </div>

                    <div class="metric-card metric-green">
                      <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-400">AVG SIGNATURE</div>
                      <div class="mt-1.5 flex items-baseline gap-1">
                        <span id="persona-sig-val" class="text-[28px] font-normal tracking-tight text-white tabular-nums leading-none">53</span>
                        <span class="text-xs text-zinc-500 font-medium">/100</span>
                      </div>
                      <div id="persona-sig-cap" class="text-xs text-zinc-300 mt-2 leading-snug">Across all rounds.</div>
                    </div>
                  </div>

                  <!-- Recent Champions History -->
                  <div class="pt-1">
                    <div class="text-[10px] font-bold uppercase tracking-[0.12em] text-zinc-500 mb-2">YOUR RECENT CHAMPIONS</div>
                    <div id="persona-recent-list" class="flex flex-wrap gap-1.5">
                      <!-- Populated dynamically -->
                    </div>
