        return `
          <button
            type="button"
            data-cat-pill="${escapeHtml(cat.id)}"
            class="cat-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold transition-all border ${
              isActive
                ? 'bg-[#e0b34c] text-obsidian border-[#e0b34c] shadow-[0_0_18px_rgba(224,179,76,0.22)]'
                : 'bg-[#14161c] hover:bg-[#1b1e26] text-zinc-300 border-[#1f232e] hover:border-[#2e3342]'
            }"
          >
            <span class="text-[13px] leading-none">${cat.emoji}</span>
            <span>${escapeHtml(cat.title)}</span>
          </button>
        `;
      }).join('');

      bar.querySelectorAll('.cat-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = BUILTIN_CATEGORIES.find((c) => c.id === btn.dataset.catPill);
          if (cat) {
