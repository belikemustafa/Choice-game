      const customBanner = document.getElementById('arena-custom-banner');
      if (state.activeDeck.isCustom) {
        customBanner.classList.remove('hidden');
        document.getElementById('arena-custom-cat-label').textContent =
          `${(state.activeDeck.categoryLabel || 'Custom').toUpperCase()} · 10-CHOICE DECK`;
        document.getElementById('arena-custom-title').textContent = state.activeDeck.title;
        document.getElementById('arena-custom-subtitle').textContent = state.activeDeck.subtitle || '';
