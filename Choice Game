    // =========================================================================
    // 2. WIKIPEDIA THUMBNAIL ENHANCER (In-Memory Cache, Smooth Fade-In)
    // =========================================================================
    const wikiImageCache = new Map();   // wikiSlug -> imageUrl | null
    const wikiPendingMap = new Map();   // wikiSlug -> Promise<string | null>

    async function fetchWikiThumbnail(wikiSlug) {
      if (!wikiSlug) return null;
      if (wikiImageCache.has(wikiSlug)) return wikiImageCache.get(wikiSlug);
      if (wikiPendingMap.has(wikiSlug)) return wikiPendingMap.get(wikiSlug);

      const promise = (async () => {
        try {
          const url = `https://en.wikipedia.org/api/rest_v1/page/summary/${wikiSlug}`;
          const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
          if (!res.ok) {
            wikiImageCache.set(wikiSlug, null);
            return null;
          }
          const data = await res.json();
          const imgUrl = data?.thumbnail?.source || data?.originalimage?.source || null;
          // Prefer a higher-resolution Wikipedia thumbnail when available
          const crispUrl = imgUrl
            ? imgUrl.replace(/\/\d+px-/, '/640px-')
            : null;
          wikiImageCache.set(wikiSlug, crispUrl);
          return crispUrl;
        } catch (_) {
          wikiImageCache.set(wikiSlug, null);
          return null;
        } finally {
          wikiPendingMap.delete(wikiSlug);
        }
      })();

      wikiPendingMap.set(wikiSlug, promise);
      return promise;
    }

    /**
     * Resolves an item's best artwork URL (custom URL first, else cached/fetched Wikipedia thumbnail)
     * and smoothly fades it into any mounted DOM elements carrying `data-art-id`.
     */
    function hydrateArtworkForChoice(choice) {
      if (!choice) return;
      if (choice.img) return;
      if (!choice.wikiSlug) return;

      const cached = wikiImageCache.get(choice.wikiSlug);
      if (cached) {
        injectImageIntoChoiceSlots(choice.id, cached);
        return;
      }
      if (cached === null) return;

      fetchWikiThumbnail(choice.wikiSlug).then((url) => {
        if (url) {
          injectImageIntoChoiceSlots(choice.id, url);
        }
      });
    }

    function injectImageIntoChoiceSlots(choiceId, imgUrl) {
      document.querySelectorAll(`[data-art-id="${CSS.escape(choiceId)}"]`).forEach((slot) => {
        if (slot.querySelector('img')) return;
        const img = document.createElement('img');
        img.src = imgUrl;
        img.alt = '';
        img.loading = 'lazy';
        img.className = 'absolute inset-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-500';
        img.onload = () => img.classList.remove('opacity-0');
        img.onerror = () => img.remove();
        slot.appendChild(img);
      });
    }

    function prefetchUpcomingRoundArtwork(choices, startIdx) {
      for (let i = startIdx; i < Math.min(choices.length, startIdx + 3); i++) {
        const ch = choices[i];
        if (ch && !ch.img && ch.wikiSlug && !wikiImageCache.has(ch.wikiSlug)) {
          fetchWikiThumbnail(ch.wikiSlug);
        }
      }
    }

    // =========================================================================
    // 3. TACTILE WEB AUDIO SOUND ENGINE
    // =========================================================================
    let soundEnabled = true;
    let audioCtx = null;

    function getAudioCtx() {
      if (!audioCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }

    function playClickTone(pitch = 430) {
      if (!soundEnabled) return;
      try {
        const ctx = getAudioCtx();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(pitch, now);
        osc.frequency.exponentialRampToValueAtTime(pitch * 1.32, now + 0.06);
        gain.gain.setValueAtTime(0.055, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.075);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.08);
      } catch (_) {}
    }

    function playChampionChime() {
      if (!soundEnabled) return;
      try {
        const ctx = getAudioCtx();
        if (!ctx) return;
        [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
          const now = ctx.currentTime + idx * 0.06;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);
          gain.gain.setValueAtTime(0.05, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.34);
        });
      } catch (_) {}
    }

    // =========================================================================
    // 4. FIREBASE FIRESTORE ENGINE (Strict Rules 1, 2, 3 + In-Memory Fallback)
    // =========================================================================
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
    let db = null;
    let auth = null;
    let currentUser = null;
    let firestoreReady = false;

    const categoryStatsCache = {};
    const customDecksCache = {};
    let userRoundHistory = [];

    async function initFirebase() {
      try {
        if (typeof __firebase_config === 'undefined' || !__firebase_config) return;
        const firebaseConfig = typeof __firebase_config === 'string'
          ? JSON.parse(__firebase_config)
          : __firebase_config;

        if (!firebaseConfig || !firebaseConfig.projectId) return;

        const fbApp = initializeApp(firebaseConfig);
        auth = getAuth(fbApp);
        db = getFirestore(fbApp);

        // RULE 3: Authenticate FIRST before any Firestore operations
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          const cred = await signInWithCustomToken(auth, __initial_auth_token);
          currentUser = cred.user;
        } else {
          const cred = await signInAnonymously(auth);
          currentUser = cred.user;
        }

        if (!currentUser) return;
        firestoreReady = true;
        subscribeToFirestore();
      } catch (err) {
        console.warn('Firestore unavailable; running with live in-memory session state:', err?.message || err);
      }
    }

    function subscribeToFirestore() {
      if (!firestoreReady || !currentUser || !db) return;

      // 1) Public built-in category vote totals (RULE 1 & RULE 2)
      const catStatsCol = collection(db, 'artifacts', appId, 'public', 'data', 'category_stats');
      onSnapshot(
        catStatsCol,
        (snapshot) => {
          snapshot.forEach((docSnap) => {
            categoryStatsCache[docSnap.id] = docSnap.data() || {};
          });
          refreshLiveUI();
        },
        (err) => console.warn('category_stats listener error:', err?.message)
      );

      // 2) Public custom 10-choice decks
      const customDecksCol = collection(db, 'artifacts', appId, 'public', 'data', 'custom_decks');
      onSnapshot(
        customDecksCol,
        (snapshot) => {
          snapshot.forEach((docSnap) => {
            const data = docSnap.data();
            if (data && Array.isArray(data.choices) && data.choices.length === 10) {
              customDecksCache[docSnap.id] = { id: docSnap.id, ...data };
            }
          });
          if (state.activeDeck?.isCustom && customDecksCache[state.activeDeck.id]) {
            state.activeDeck = { ...customDecksCache[state.activeDeck.id], isCustom: true };
          }
          refreshLiveUI();
        },
        (err) => console.warn('custom_decks listener error:', err?.message)
      );

      // 3) Private user round history for YOUR PERSONA
      const historyCol = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'round_history');
      onSnapshot(
        historyCol,
        (snapshot) => {
          const rows = [];
          snapshot.forEach((docSnap) => rows.push({ id: docSnap.id, ...docSnap.data() }));
          // Sort in JS memory (RULE 2: no compound queries or orderBy)
          rows.sort((a, b) => (b.playedAt || 0) - (a.playedAt || 0));
          userRoundHistory = rows;
          if (state.view === 'results') renderPersonaTab();
        },
        (err) => console.warn('round_history listener error:', err?.message)
      );
    }

    async function persistRoundResults(deck, champion, roundChoices, duelWinsMap, tasteMetrics) {
      // Immediate in-memory cache update
      if (deck.isCustom) {
        if (!customDecksCache[deck.id]) {
          customDecksCache[deck.id] = { ...deck, totalPlays: 0, champions: {}, duelWins: {}, appearances: {} };
        }
        const e = customDecksCache[deck.id];
        e.totalPlays = (e.totalPlays || 0) + 1;
        e.champions = { ...(e.champions || {}), [champion.id]: ((e.champions || {})[champion.id] || 0) + 1 };
        e.duelWins = { ...(e.duelWins || {}) };
        Object.entries(duelWinsMap).forEach(([cid, cnt]) => { e.duelWins[cid] = (e.duelWins[cid] || 0) + cnt; });
        e.appearances = { ...(e.appearances || {}) };
        roundChoices.forEach((c) => { e.appearances[c.id] = (e.appearances[c.id] || 0) + 1; });
        state.activeDeck = { ...e, isCustom: true };
      } else {
        if (!categoryStatsCache[deck.id]) {
          categoryStatsCache[deck.id] = { totalPlays: 0, champions: {}, duelWins: {}, appearances: {} };
        }
        const e = categoryStatsCache[deck.id];
        e.totalPlays = (e.totalPlays || 0) + 1;
        e.champions = { ...(e.champions || {}), [champion.id]: ((e.champions || {})[champion.id] || 0) + 1 };
        e.duelWins = { ...(e.duelWins || {}) };
        Object.entries(duelWinsMap).forEach(([cid, cnt]) => { e.duelWins[cid] = (e.duelWins[cid] || 0) + cnt; });
        e.appearances = { ...(e.appearances || {}) };
        roundChoices.forEach((c) => { e.appearances[c.id] = (e.appearances[c.id] || 0) + 1; });
      }

      const historyEntry = {
        playedAt: Date.now(),
        deckId: deck.id,
        deckTitle: deck.title,
        categoryLabel: deck.isCustom ? (deck.categoryLabel || 'Custom') : deck.title,
        championId: champion.id,
        championName: champion.name,
        championEmoji: champion.emoji || '🏆',
        crowdSync: tasteMetrics.crowdSync,
        rareTaste: tasteMetrics.rareTaste,
        hotTakes: tasteMetrics.hotTakes,
        signature: tasteMetrics.signature,
        archetypeTitle: tasteMetrics.archetype.title,
      };

      userRoundHistory = [historyEntry, ...userRoundHistory.filter((h) => h.playedAt !== historyEntry.playedAt)];

      if (!firestoreReady || !currentUser || !db) return;

      try {
        const duelWinInc = {};
        Object.entries(duelWinsMap).forEach(([cid, cnt]) => { duelWinInc[cid] = increment(cnt); });
        const appInc = {};
        roundChoices.forEach((c) => { appInc[c.id] = increment(1); });

        if (deck.isCustom) {
          const deckRef = doc(db, 'artifacts', appId, 'public', 'data', 'custom_decks', deck.id);
          await setDoc(deckRef, {
            id: deck.id,
            title: deck.title,
            categoryLabel: deck.categoryLabel || 'Custom',
            subtitle: deck.subtitle || '',
            choices: deck.choices,
            totalPlays: increment(1),
            champions: { [champion.id]: increment(1) },
            duelWins: duelWinInc,
            appearances: appInc,
            updatedAt: Date.now(),
          }, { merge: true });
        } else {
          const catRef = doc(db, 'artifacts', appId, 'public', 'data', 'category_stats', deck.id);
          await setDoc(catRef, {
            totalPlays: increment(1),
            champions: { [champion.id]: increment(1) },
            duelWins: duelWinInc,
            appearances: appInc,
            updatedAt: Date.now(),
          }, { merge: true });
        }

        const histId = `r_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
        const histRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'round_history', histId);
        await setDoc(histRef, historyEntry);
      } catch (err) {
        console.warn('Firestore round save skipped:', err?.message);
      }
    }

