    async function fetchCustomDeckById(deckId) {
      if (customDecksCache[deckId]) return customDecksCache[deckId];
      if (!firestoreReady || !currentUser || !db) return null;
      try {
        const snap = await getDoc(doc(db, 'artifacts', appId, 'public', 'data', 'custom_decks', deckId));
        if (snap.exists()) {
          const data = { id: snap.id, ...snap.data() };
          customDecksCache[deckId] = data;
