    // =========================================================================
    // 5. SHARE LINK ENCODER / DECODER (?deck=ID#custom=base64)
    // =========================================================================
    function toBase64Url(str) {
      const bytes = new TextEncoder().encode(str);
      let bin = '';
      bytes.forEach((b) => { bin += String.fromCharCode(b); });
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
    }

    function fromBase64Url(b64url) {
      const pad = b64url.length % 4 === 0 ? '' : '='.repeat(4 - (b64url.length % 4));
      const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/') + pad;
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new TextDecoder().decode(bytes);
    }

    function buildShareUrl(deck) {
      const base = `${window.location.origin}${window.location.pathname}`;
      if (!deck.isCustom) {
        const sub = state.activeSubFilter && state.activeSubFilter !== 'all'
          ? `&sub=${encodeURIComponent(state.activeSubFilter)}`
          : '';
        return `${base}?cat=${encodeURIComponent(deck.id)}${sub}`;
      }
      const compact = {
        i: deck.id,
        t: deck.title,
        k: deck.categoryLabel || 'Custom',
        s: deck.subtitle || '',
        c: deck.choices.map((ch) => [
          ch.name,
          ch.emoji || '✨',
          ch.paletteIdx ?? 0,
          ch.tag || '',
          ch.img || ''
        ])
      };
      return `${base}?deck=${encodeURIComponent(deck.id)}#custom=${toBase64Url(JSON.stringify(compact))}`;
    }

    function parseDeckFromShareString(inputStr) {
      try {
        const trimmed = inputStr.trim();
        const hashMatch = trimmed.match(/#(?:custom|c)=([A-Za-z0-9\-_]+)/);
        if (hashMatch && hashMatch[1]) {
          const p = JSON.parse(fromBase64Url(hashMatch[1]));
          if (p && p.t && Array.isArray(p.c) && p.c.length === 10) {
            return {
              id: p.i || `d_${Date.now().toString(36)}`,
              title: p.t,
              categoryLabel: p.k || 'Custom',
              subtitle: p.s || '',
              isCustom: true,
              totalPlays: 0,
              champions: {},
              duelWins: {},
              appearances: {},
              choices: p.c.map((arr, idx) => ({
                id: `c${idx + 1}`,
                name: String(arr[0] || `Choice ${idx + 1}`),
                emoji: String(arr[1] || '✨'),
                paletteIdx: Number(arr[2]) || (idx % PALETTES.length),
                gradient: PALETTES[(Number(arr[2]) || idx) % PALETTES.length],
                tag: String(arr[3] || ''),
                img: arr[4] ? String(arr[4]) : null,
                wikiSlug: '',
                seedVotes: 0,
              }))
            };
          }
        }
        const deckMatch = trimmed.match(/[?&]deck=([A-Za-z0-9_\-]+)/);
        if (deckMatch && deckMatch[1]) return { deckIdOnly: deckMatch[1] };

        const catMatch = trimmed.match(/[?&]cat=([A-Za-z0-9_\-]+)/);
        const subMatch = trimmed.match(/[?&]sub=([A-Za-z0-9_\-]+)/);
        if (catMatch && catMatch[1]) return { catIdOnly: catMatch[1], subFilter: subMatch?.[1] || 'all' };

        if (/^[A-Za-z0-9_\-]{5,40}$/.test(trimmed)) return { deckIdOnly: trimmed };
      } catch (_) {}
      return null;
    }

    // =========================================================================
    // 6. STATS, LEADERBOARD & TASTE RATING ANALYTICS
    // =========================================================================
    function formatVoteCount(n) {
      if (n >= 1000000) return `${(n / 1000000).toFixed(1).replace(/\.0$/, '')}m`;
      if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`;
      return String(n);
    }

    function getDeckTotalVotes(deck) {
      if (deck.isCustom) {
        const live = customDecksCache[deck.id];
        return live?.totalPlays ?? deck.totalPlays ?? 0;
      }
      const live = categoryStatsCache[deck.id];
      return (deck.seedTotalPlays || 0) + (live?.totalPlays || 0);
    }

    function getFilteredPool(deck, subFilter = 'all') {
      if (!deck || deck.isCustom || !deck.subFilters || subFilter === 'all') {
        return deck?.choices || [];
      }
      const filtered = deck.choices.filter((c) => c.group === subFilter);
      return filtered.length >= 10 ? filtered : deck.choices;
    }

    function computeLeaderboard(deck, subsetChoices = null) {
      const choices = subsetChoices || deck.choices;
      const live = deck.isCustom ? (customDecksCache[deck.id] || deck) : (categoryStatsCache[deck.id] || {});
      const liveChamps = live.champions || {};
      const liveDuels = live.duelWins || {};

      const scored = choices.map((ch) => {
        const seedScore = deck.isCustom ? 0 : (ch.seedVotes || 100);
        const realChampVotes = liveChamps[ch.id] || 0;
        const realDuelWins = liveDuels[ch.id] || 0;
        const effectiveScore = deck.isCustom
          ? (realChampVotes * 10 + realDuelWins)
          : (seedScore + realChampVotes * 12 + realDuelWins * 1.5);

        return {
          ...ch,
          champVotes: (deck.isCustom ? 0 : ch.seedVotes) + realChampVotes,
          realChampVotes,
          realDuelWins,
          effectiveScore,
        };
      });

      scored.sort((a, b) => b.effectiveScore - a.effectiveScore || a.name.localeCompare(b.name));

      const totalScore = scored.reduce((s, item) => s + item.effectiveScore, 0);
      const maxScore = scored[0]?.effectiveScore || 1;

      return scored.map((item, idx) => {
        const rawPct = totalScore > 0 ? (item.effectiveScore / totalScore) * 100 : (100 / scored.length);
        const pct = Math.max(0, Math.round(rawPct));
        const barWidthPct = maxScore > 0 ? Math.max(8, Math.round((item.effectiveScore / maxScore) * 100)) : 50;
        return { ...item, rank: idx + 1, pct, rawPct, barWidthPct };
      });
    }

    function classifyArchetype(crowdSync, rareTaste, hotTakes, signature) {
      if (crowdSync >= 72 && hotTakes < 42) {
        return { title: 'Crowd Whisperer', desc: 'You and the room share one brain. Effortless consensus.' };
      }
      if (crowdSync >= 62 && rareTaste < 38) {
        return { title: 'Mainstream Icon', desc: 'You know exactly why the all-time classics sit on top.' };
      }
      if (crowdSync <= 32 && hotTakes >= 68) {
        return { title: 'Hot-Take Rebel', desc: "If everyone agrees, you're already stirring the room." };
      }
      if (rareTaste >= 64 && signature >= 52) {
        return { title: 'Cult Connoisseur', desc: 'Selective, refined, and proudly off the mainstream radar.' };
      }
      if (hotTakes >= 72 && signature < 52) {
        return { title: 'Wildcard Maverick', desc: 'Zero loyalty to seeding. Pure instinct and drama.' };
      }
      if (signature >= 68 && crowdSync >= 38 && crowdSync <= 68) {
        return { title: 'Sharp Tastemaker', desc: 'Confident conviction with an eye for what rises next.' };
      }
      return { title: 'Balanced Critic', desc: 'Some with the room, some against. You pick your spots.' };
    }

    function getMetricCaptions(crowdSync, rareTaste, hotTakes, signature) {
      return {
        crowdCap:
          crowdSync >= 80 ? 'Voice of the room.' :
          crowdSync >= 60 ? 'Right on the pulse.' :
          crowdSync >= 40 ? 'Half with the crowd.' :
          crowdSync >= 20 ? 'You go your own way.' : 'Total lone wolf.',
        rareCap:
          rareTaste >= 80 ? 'Deep-cut connoisseur.' :
          rareTaste >= 60 ? 'Cult classic radar.' :
          rareTaste >= 40 ? 'Off-radar a bit.' :
          rareTaste >= 20 ? 'Familiar favorites.' : 'Mainstream comfort.',
        hotCap:
          hotTakes >= 85 ? 'All in. No fence.' :
          hotTakes >= 65 ? 'Spicy upsets.' :
          hotTakes >= 40 ? 'Selective rebellions.' :
          hotTakes >= 20 ? 'Measured instincts.' : 'Playing it safe.',
        sigCap:
          signature >= 80 ? 'Unmistakable identity.' :
          signature >= 60 ? 'Sharp instincts.' :
          signature >= 40 ? 'Loose pattern.' :
          signature >= 20 ? 'Wildcard energy.' : 'Pure chaos mode.',
      };
    }

    function calculateTasteRating(deck, roundChoices, duelHistory, champion) {
      const board = computeLeaderboard(deck, roundChoices);
      const rankById = {};
      board.forEach((item) => { rankById[item.id] = item.rank; });

      const n = board.length || 10;
      const isFreshCustom = deck.isCustom && getDeckTotalVotes(deck) <= 1;

      let agreedWithCrowd = 0;
      let raritySum = 0;
      let upsetSum = 0;
      let maxUpset = 0;
      let knockedOutTopSeed = false;

      const winsPerChoice = {};
      let maxStreak = 0;

      duelHistory.forEach((duel) => {
        const wRank = rankById[duel.winner.id] || 5;
        const lRank = rankById[duel.loser.id] || 5;
        winsPerChoice[duel.winner.id] = (winsPerChoice[duel.winner.id] || 0) + 1;
        if (winsPerChoice[duel.winner.id] > maxStreak) maxStreak = winsPerChoice[duel.winner.id];

        if (wRank < lRank) {
          agreedWithCrowd += 1;
        } else if (wRank > lRank) {
          const gap = (wRank - lRank) / Math.max(1, n - 1);
          upsetSum += gap;
          if (gap > maxUpset) maxUpset = gap;
          if (lRank <= 2) knockedOutTopSeed = true;
        } else {
          agreedWithCrowd += 0.5;
        }

        raritySum += (wRank - 1) / Math.max(1, n - 1);
      });

      const champRank = rankById[champion.id] || 5;
      const champPop = (n - champRank) / Math.max(1, n - 1);
      const champRarity = (champRank - 1) / Math.max(1, n - 1);
      const champWins = winsPerChoice[champion.id] || 1;

      let crowdSync, rareTaste, hotTakes, signature;
      if (isFreshCustom) {
        crowdSync = 88;
        rareTaste = 50;
        hotTakes = Math.min(95, 45 + champWins * 7);
        signature = Math.min(98, 52 + maxStreak * 6);
      } else {
        const agreeRatio = agreedWithCrowd / Math.max(1, duelHistory.length);
        crowdSync = Math.round((agreeRatio * 0.62 + champPop * 0.38) * 100);
        rareTaste = Math.round((champRarity * 0.58 + (raritySum / Math.max(1, duelHistory.length)) * 0.42) * 100);

        let rawHot = (upsetSum / Math.max(1, duelHistory.length)) * 145 + maxUpset * 38 + (knockedOutTopSeed ? 24 : 0);
        if (champRank >= 6) rawHot += 16;
        hotTakes = Math.min(100, Math.max(6, Math.round(rawHot)));

        const alignmentClarity = Math.abs(agreeRatio - 0.5) * 2;
        const streakStrength = Math.min(1, maxStreak / 7);
        const champRun = Math.min(1, champWins / 6);
        signature = Math.min(99, Math.max(18, Math.round((streakStrength * 0.45 + alignmentClarity * 0.30 + champRun * 0.25) * 100)));
      }

      crowdSync = Math.min(100, Math.max(0, crowdSync));
      rareTaste = Math.min(100, Math.max(0, rareTaste));
      hotTakes = Math.min(100, Math.max(0, hotTakes));
      signature = Math.min(100, Math.max(0, signature));

      return {
        crowdSync,
        rareTaste,
        hotTakes,
        signature,
        archetype: classifyArchetype(crowdSync, rareTaste, hotTakes, signature),
        captions: getMetricCaptions(crowdSync, rareTaste, hotTakes, signature),
        champWins
      };
    }

    // =========================================================================
    // 7. APPLICATION STATE & KNOCKOUT ENGINE
    // =========================================================================
    const state = {
      view: 'arena', // 'arena' | 'results' | 'creator'
      activeDeck: null,
      activeSubFilter: 'all',
      seenByPoolKey: {},
      hideNames: false,
      tasteExpanded: false,
      tasteTab: 'post',
      lbMode: 'round',
      isAnimatingPick: false,

      roundChoices: [],
      topChoice: null,
      bottomChoice: null,
      topStreak: 0,
      bottomStreak: 0,
      nextIndex: 2,
      duelNumber: 1,
      duelHistory: [],
      duelWinsMap: {},
      champion: null,
      lastTasteMetrics: null,

      creatorSlots: [],
      lastCreatedDeck: null,
      activeEmojiSlotIdx: null,
    };

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    /**
     * Deals 10 choices from the active category & sub-filter pool,
     * cycling through unseen items before repeating.
     */
    function dealTenChoices(deck, subFilter = 'all') {
      const pool = getFilteredPool(deck, subFilter);
      if (pool.length <= 10) return shuffleArray(pool);

      const poolKey = `${deck.id}::${subFilter}`;
      if (!state.seenByPoolKey[poolKey]) state.seenByPoolKey[poolKey] = new Set();
      const seen = state.seenByPoolKey[poolKey];

      const unseen = shuffleArray(pool.filter((c) => !seen.has(c.id)));
      const alreadySeen = shuffleArray(pool.filter((c) => seen.has(c.id)));

      let dealt;
      if (unseen.length >= 10) {
        dealt = unseen.slice(0, 10);
      } else {
        dealt = [...unseen, ...alreadySeen.slice(0, 10 - unseen.length)];
        seen.clear();
      }

      dealt.forEach((c) => seen.add(c.id));
      return shuffleArray(dealt);
    }

    function startRound(deck, options = {}) {
      const { subFilter = null, rematchSameChoices = null } = options;

      state.activeDeck = deck;
      if (subFilter !== null) {
        state.activeSubFilter = subFilter;
      } else if (!deck.subFilters) {
        state.activeSubFilter = 'all';
      }

      state.view = 'arena';
      state.isAnimatingPick = false;
      state.duelHistory = [];
      state.duelWinsMap = {};
      state.champion = null;
      state.lastTasteMetrics = null;
      state.lbMode = 'round';
      state.tasteExpanded = false;

      if (rematchSameChoices && rematchSameChoices.length === 10) {
        state.roundChoices = shuffleArray(rematchSameChoices);
      } else {
        state.roundChoices = dealTenChoices(deck, state.activeSubFilter);
      }

      state.topChoice = state.roundChoices[0];
      state.bottomChoice = state.roundChoices[1];
      state.topStreak = 0;
      state.bottomStreak = 0;
      state.nextIndex = 2;
      state.duelNumber = 1;

      updateHeader();
      renderCategoryBar();
      showView('arena');
      renderArena(true, true);
      prefetchUpcomingRoundArtwork(state.roundChoices, 2);
    }

    function handlePick(side) {
      if (state.view !== 'arena' || state.isAnimatingPick) return;
      state.isAnimatingPick = true;

      const winner = side === 'top' ? state.topChoice : state.bottomChoice;
      const loser = side === 'top' ? state.bottomChoice : state.topChoice;
      const winEl = document.getElementById(side === 'top' ? 'card-top' : 'card-bottom');
      const loseEl = document.getElementById(side === 'top' ? 'card-bottom' : 'card-top');

      playClickTone(side === 'top' ? 460 : 410);
      winEl.classList.add('picked-win');
      loseEl.classList.add('picked-lose');

      state.duelHistory.push({ winner, loser });
      state.duelWinsMap[winner.id] = (state.duelWinsMap[winner.id] || 0) + 1;

      if (side === 'top') {
        state.topStreak += 1;
        state.bottomStreak = 0;
      } else {
        state.bottomStreak += 1;
        state.topStreak = 0;
      }

      setTimeout(async () => {
        winEl.classList.remove('picked-win');
        loseEl.classList.remove('picked-lose');

        if (state.nextIndex >= state.roundChoices.length) {
          state.champion = winner;
          state.lastTasteMetrics = calculateTasteRating(
            state.activeDeck,
            state.roundChoices,
            state.duelHistory,
            winner
          );

          playChampionChime();

          await persistRoundResults(
            state.activeDeck,
            winner,
            state.roundChoices,
            state.duelWinsMap,
            state.lastTasteMetrics
          );

          state.isAnimatingPick = false;
          state.view = 'results';
          updateHeader();
          showView('results');
          renderResults();
        } else {
          const nextChallenger = state.roundChoices[state.nextIndex];
          state.nextIndex += 1;
          state.duelNumber += 1;

          if (side === 'top') {
            state.bottomChoice = nextChallenger;
            renderArena(false, true);
          } else {
            state.topChoice = nextChallenger;
            renderArena(true, false);
          }

          prefetchUpcomingRoundArtwork(state.roundChoices, state.nextIndex);
          state.isAnimatingPick = false;
        }
      }, 230);
    }

    // =========================================================================
