    function renderPersonaTab() {
      const hist = userRoundHistory;
      const count = hist.length;
      if (count === 0) return;

      const avg = (key) => Math.round(hist.reduce((s, r) => s + (r[key] || 0), 0) / count);
      const crowd = avg('crowdSync');
      const rare = avg('rareTaste');
      const hot = avg('hotTakes');
      const sig = avg('signature');

      // Find top played category
      const catCounts = {};
      hist.forEach((r) => {
        const label = r.categoryLabel || r.deckTitle || 'Movies';
        catCounts[label] = (catCounts[label] || 0) + 1;
      });
      const topCat = Object.entries(catCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || 'Movies';

      const personaArchetype = classifyArchetype(crowd, rare, hot, sig);
      const caps = getMetricCaptions(crowd, rare, hot, sig);

      document.getElementById('persona-archetype-title').textContent = personaArchetype.title;
      document.getElementById('persona-archetype-desc').textContent = personaArchetype.desc;
      document.getElementById('persona-rounds-badge').textContent = `${count} ${count === 1 ? 'round' : 'rounds'}`;
      document.getElementById('persona-top-cat').textContent = `Top: ${topCat}`;

      document.getElementById('persona-crowd-val').textContent = crowd;
      document.getElementById('persona-crowd-cap').textContent = caps.crowdCap;
      document.getElementById('persona-rare-val').textContent = rare;
      document.getElementById('persona-rare-cap').textContent = caps.rareCap;
      document.getElementById('persona-hot-val').textContent = hot;
      document.getElementById('persona-hot-cap').textContent = caps.hotCap;
      document.getElementById('persona-sig-val').textContent = sig;
      document.getElementById('persona-sig-cap').textContent = caps.sigCap;

      document.getElementById('persona-recent-list').innerHTML = hist.slice(0, 8).map((r) => `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#161922] border border-[#242834] text-xs text-zinc-200">
          <span>${escapeHtml(r.championEmoji || '🏆')}</span>
          <span class="font-medium truncate max-w-[140px]">${escapeHtml(r.championName)}</span>
        </span>
      `).join('');
    }

    function renderLeaderboardRows() {
      const deck = state.activeDeck;
      if (!deck) return;

      const fullPool = getFilteredPool(deck, state.activeSubFilter);
      const isRoundMode = state.lbMode === 'round' || fullPool.length <= 10;

      document.getElementById('btn-lb-round').className = isRoundMode
        ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#222633] text-white transition-all'
        : 'px-3 py-1.5 rounded-lg text-xs font-semibold text-zinc-400 hover:text-zinc-200 transition-all';
      document.getElementById('btn-lb-all').className = !isRoundMode
        ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#222633] text-white transition-all'
        : 'px-3 py-1.5 rounded-lg text-xs font-semibold text-zinc-400 hover:text-zinc-200 transition-all';

      const rows = computeLeaderboard(deck, isRoundMode ? state.roundChoices : fullPool);
      const champId = state.champion?.id;

      // All-Time #1 Leader Spotlight Card
      const leaderCard = document.getElementById('alltime-leader-card');
      if (!isRoundMode && rows[0]) {
        const top = rows[0];
        leaderCard.classList.remove('hidden');
        document.getElementById('alltime-leader-thumb').innerHTML = buildThumbHtml(top, 'w-11 h-11');
        document.getElementById('alltime-leader-name').textContent = top.name;
        const crownStr = deck.isCustom
          ? `${top.realChampVotes} ${top.realChampVotes === 1 ? 'crown' : 'crowns'}`
          : `${formatVoteCount(top.champVotes)} crowns`;
        document.getElementById('alltime-leader-meta').textContent =
          `${crownStr}${top.tag ? ` · ${top.tag}` : ''}`;
        document.getElementById('alltime-leader-share').innerHTML = `
          <div class="text-lg font-extrabold text-[#e0b34c] tabular-nums leading-none">${top.pct}%</div>
          <div class="text-[10px] text-zinc-500 uppercase tracking-wider mt-0.5">win share</div>
        `;
        hydrateArtworkForChoice(top);
      } else {
        leaderCard.classList.add('hidden');
      }

      const container = document.getElementById('leaderboard-list');
      container.innerHTML = rows.map((item) => {
        const isChamp = item.id === champId;
        const rankColor =
          item.rank === 1 ? 'text-[#e0b34c]' :
          item.rank === 2 ? 'text-zinc-200' :
          item.rank === 3 ? 'text-[#d8894a]' :
          'text-zinc-500';

        const rowBorder = isChamp
          ? 'border-[#7c3526] bg-[#161112]'
          : 'border-[#1d2028] bg-[#12141a]';

        const fillColor = isChamp
          ? 'bg-[#2a1716]'
          : 'bg-[#1c202b]';

        const crownTag = item.rank === 1
          ? `<span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[#e0b34c]/15 text-[#e0b34c] border border-[#e0b34c]/30">Highest</span>`
          : '';

        const subMeta = !isRoundMode
          ? `<div class="text-[10px] text-zinc-500 truncate">${deck.isCustom ? `${item.realChampVotes} crowns` : `${formatVoteCount(item.champVotes)} crowns`}${item.tag ? ` · ${escapeHtml(item.tag)}` : ''}</div>`
          : '';

        return `
          <div class="relative rounded-xl border ${rowBorder} overflow-hidden transition-all">
            <div class="lb-fill absolute inset-y-0 left-0 ${fillColor} rounded-r-lg pointer-events-none" style="width: ${item.barWidthPct}%;"></div>

            <div class="relative z-10 flex items-center justify-between gap-3 px-3.5 py-2.5">
              <div class="flex items-center gap-3 min-w-0">
                <span class="w-5 text-center text-sm font-bold tabular-nums shrink-0 ${rankColor}">${item.rank}</span>
                ${buildThumbHtml(item, 'w-9 h-9')}
                <div class="min-w-0">
                  <div class="flex items-center flex-wrap gap-y-0.5">
                    <span class="text-[14px] font-semibold text-zinc-100 truncate">${escapeHtml(item.name)}</span>
                    ${crownTag}
                  </div>
                  ${subMeta}
                </div>
              </div>
              <div class="text-right shrink-0">
                <span class="text-[14px] font-bold text-zinc-100 tabular-nums">${item.pct}%</span>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Progressively hydrate Wikipedia thumbnails for visible top rows
      rows.slice(0, 15).forEach((item) => hydrateArtworkForChoice(item));
    }

